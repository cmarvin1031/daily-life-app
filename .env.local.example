# Copy this file to .env.local and fill in your Supabase project's API
# settings (Project Settings -> API). The anon key is safe to expose in the
# client bundle -- Row Level Security is the real access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Calendar sync needs nothing here: it runs server-side in a Supabase
# Edge Function whose secrets are set in the Supabase dashboard. See
# README.md, "Google Calendar sync".

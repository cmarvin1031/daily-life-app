# Copy this file to .env.local and fill in your Supabase project's API
# settings (Project Settings -> API). The anon key is safe to expose in the
# client bundle -- Row Level Security is the real access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Calendar integration on the Planner page. OAuth Client ID
# (Web application type) from Google Cloud Console -- safe to expose in the
# client bundle, it's a public identifier, not a secret. See README.md.
VITE_GOOGLE_CLIENT_ID=
